# Release signing config for app/build.gradle.kts.
#
# 1. Copy this file to `keystore.properties` (which is gitignored — NEVER commit the real one).
# 2. Generate an upload/release keystore, e.g.:
#
#      keytool -genkeypair -v \
#        -keystore otpphone-release.jks \
#        -alias otpphone \
#        -keyalg RSA -keysize 4096 -validity 10000 \
#        -storetype PKCS12
#
# 3. Fill in the four values below to match what you chose.
# 4. Back up the .jks file AND these passwords somewhere durable and offline. With Play App
#    Signing this is your *upload* key (a lost upload key is recoverable via Play support);
#    for self-distribution outside Play, losing it means you can never sign an update for the
#    same app identity again.
#
# storeFile may be an absolute path or relative to the repo root.

storeFile=otpphone-release.jks
storePassword=CHANGE_ME
keyAlias=otpphone
keyPassword=CHANGE_ME

# CI alternative: instead of this file, set these environment variables —
#   OTPPHONE_KEYSTORE_FILE, OTPPHONE_KEYSTORE_PASSWORD, OTPPHONE_KEY_ALIAS, OTPPHONE_KEY_PASSWORD
